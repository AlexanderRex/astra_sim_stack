+class LidPushPostureAction(ActionTerm):
+    """Development-only right arm posture override through normal joint drives."""
+
+    def __init__(self, cfg, env):
+        super().__init__(cfg, env)
+        if env.num_envs != 1:
+            raise ValueError("Stage 1 joint posture experiments require one environment")
+        names = [f"right_arm_joint{i}" for i in range(1, 8)]
+        self._joint_ids = [self._asset.data.joint_names.index(name) for name in names]
+        self._command = torch.zeros((env.num_envs, 8), device=env.device)
+
+    @property
+    def action_dim(self):
+        return 8
+
+    @property
+    def raw_actions(self):
+        return self._command
+
+    @property
+    def processed_actions(self):
+        return self._command
+
+    def process_actions(self, actions):
+        if not torch.isfinite(actions).all():
+            raise ValueError("Nonfinite right arm posture action")
+        self._command.copy_(actions)
+
+    def reset(self, env_ids=None):
+        self._command[env_ids] = 0.
+
+    def apply_actions(self):
+        if self._command[0, 0] <= .5:
+            return
+        q = as_torch(self._asset.data.joint_pos)[:, self._joint_ids]
+        limits = as_torch(self._asset.data.joint_pos_limits)[:, self._joint_ids]
+        # Bound tracking lead so the drives do not jump to the final posture.
+        delta = (self._command[:, 1:] - q).clamp(-0.06, 0.06)
+        target = (q + delta).clamp(limits[..., 0], limits[..., 1])
+        self._asset.set_joint_position_target_index(target=target, joint_ids=self._joint_ids)
+
+
+@configclass
+class LidPushMobileActionsCfg(MobileActionsCfg):
+    lid_push_posture = ActionTermCfg(asset_name="robot", class_type=LidPushPostureAction)
