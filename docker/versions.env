# Single source of versions and image names. Read by scripts/build_*.sh and, via --env-file, by docker compose.
ISAACSIM_VERSION=6.0.1
ISAACLAB_BASE_IMAGE=astra/isaac-lab-base:6.0.1
ISAACLAB_SLIM_IMAGE=astra/isaac-lab-slim:6.0.1
SIM_IMAGE=astra/sim
POLICY_IMAGE=astra/policy

# GR00T runtime (checkpoint galbot_run1, trained 2026-11-24 from the main branches below).
# Isaac-GR00T code: defines the model and its preprocessing; must match training.
ISAAC_GR00T_COMMIT=708617f5716c63fc0a327391492ea2b91977ae90
# Isaac-GR00T's own image at that commit (scripts/groot_load_test.sh builds it from third_party/isaac_gr00t).
GR00T_IMAGE=astra/gr00t
# Backbone files GR00T loads by name at run time. Only tokenizer/processor/config matter: the
# checkpoint overwrites the weights (its backbone equals GR00T-N1.7-3B's, bit for bit).
COSMOS_REVISION=9ce19a195e423419c349abfc86fd07178b230561
# Starting point of the fine-tune; not loaded at run time.
GROOT_BASE_REVISION=373d34e2723d928870157d07dc216a19a624b5bb
